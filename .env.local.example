# Copy sang .env.local rồi điền giá trị thật — KHÔNG commit file .env.local lên git
#
# Provider: APIVN (đa mô hình)
LLM_BASE_URL=https://api.apivn.tech/v1
LLM_API_KEY=

# Chuỗi Fallback tuần tự: Primary -> Fallback-1 -> Fallback-2
# Nếu 1 tầng lỗi (HTTP 4xx/5xx, timeout 45s, phản hồi rỗng) -> tự động nhảy tầng kế tiếp
LLM_PRIMARY_MODEL=deepseek-v4.1-flash
LLM_FALLBACK_MODEL_1=gemini-3.7-flash
LLM_FALLBACK_MODEL_2=glm-5.3
